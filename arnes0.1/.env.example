# Copy to .env and fill in. `.env` is gitignored; keys are read via
# `node --env-file-if-exists=.env`.

# Required — the Anthropic provider reads this at the first Send call.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — overrides the default model (claude-sonnet-4-5) at startup.
# Change it at runtime with /model.
LLM_MODEL=

# Optional — the port only wires Anthropic today, so this is informational.
LLM_PROVIDER=anthropic
