{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Gobierno de una tool call",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "runtime",
      "label": "Camino permitido"
    },
    {
      "id": "human",
      "label": "Aprobación humana y cola",
      "variant": "exception"
    },
    {
      "id": "deny",
      "label": "Denegación fail-closed",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "propose",
    "resolve",
    "policy",
    "execute",
    "result",
    "tail"
  ],
  "nodes": [
    {
