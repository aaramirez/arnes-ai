    {
      "id": "e-exec",
      "from": "execute",
      "to": "result"
    },
    {
      "id": "e-tail",
      "from": "result",
      "to": "tail",
      "variant": "emphasis"
    },
    {
      "id": "e-deny-tail",
      "from": "denyobs",
      "to": "tail",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Política fail-closed y pausa",
      "items": [
        "Orden fijo: sin regla → DENY (NO_APPLICABLE_POLICY_RULE); no permite → DENY (POLICY_DENIED); aprobación → REQUIRE_APPROVAL; permite → ALLOW",
        "REQUIRE_APPROVAL: createHumanInteractionRequest PENDING, WAITING_FOR_HUMAN + checkpoint; beginToolApprovalPause retorna, nada espera",
        "Evidencia: ch08:794-860, ch08:882-908, ch05:514-518, ch05:728-760, ch06:847-956"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ejecución y cola compartida",
      "items": [
        "executeToolCall: beforeToolCall → execute → afterToolCall; TOOL_CALL_COMPLETED o FAILED",
        "resumeTurnWithObservation: continuación → contexto → modelo → runTurn → checkpoint",
        "Evidencia: ch02:674-764, ch13:734-997, ARCHITECTURE_CONSTITUTION.md:468-498 (Article VI)"
      ]
    },
    {
      "dot": "slate",
      "title": "Alcance y compresión",
      "items": [
        "CH-13 no se llama desde runAgentTurnEndToEnd (ch13:643-646): caminos documentados, no cableados",
        "Compresión: decisiones como etiquetas; DENY + observación en un nodo; REJECTED (HUMAN_APPROVAL_REJECTED) va directo a la cola",
        "chNN = repos/aaramirez/book-harness/book/chapters/NN-*/chapter.md; constitución en repos/aaramirez/book-harness/constitution/"
      ]
    }
  ]
}
