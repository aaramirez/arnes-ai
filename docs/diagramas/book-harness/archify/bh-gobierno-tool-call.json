      "width": 140
    },
    {
      "id": "resolve",
      "lane": "runtime",
      "col": 1,
      "type": "backend",
      "label": "CapabilityRegistry",
      "sublabel": "resolve…ToolCall",
      "width": 140
    },
    {
      "id": "policy",
      "lane": "runtime",
      "col": 2,
      "type": "security",
      "label": "PolicyEngine",
      "sublabel": "orden fijo",
      "width": 140
    },
    {
      "id": "execute",
      "lane": "runtime",
      "col": 3,
      "type": "backend",
      "label": "ToolRuntime",
      "sublabel": "before → exec → after",
      "width": 140
    },
    {
      "id": "result",
      "lane": "runtime",
      "col": 4,
      "type": "database",
