      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-approval",
      "from": "policy",
      "to": "pause",
      "label": "REQUIRE_APPROVAL",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "e-allow",
      "from": "policy",
      "to": "execute",
      "label": "ALLOW",
      "variant": "emphasis"
    },
    {
