{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Gobierno de una tool call v0.3",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Gobierno y ejecución"
    },
    {
      "id": "wait",
      "label": "Esperas durables",
      "variant": "exception"
    },
    {
      "id": "close",
      "label": "Fallos y bloqueos",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "prop",
    "resolve",
    "policy",
    "hooks",
    "exec",
    "commit"
  ],
  "nodes": [
    {
      "id": "prop",
      "lane": "main",
      "col": 0,
      "type": "external",
      "label": "Propuesta",
      "sublabel": "journal o modelo",
      "width": 96
    },
    {
      "id": "resolve",
      "lane": "main",
      "col": 1,
      "type": "backend",
      "label": "CapabilityRegistry",
      "sublabel": "resolveModelProposedToolCall",
      "width": 146
    },
    {
      "id": "policy",
      "lane": "main",
      "col": 2,
      "type": "security",
      "label": "PolicyEngine",
      "sublabel": "evaluatePolicyForCaller",
      "width": 104
    },
    {
      "id": "hooks",
      "lane": "main",
      "col": 3,
      "type": "security",
      "label": "Hooks BEFORE_TOOL",
      "sublabel": "extensiones ACTIVE",
      "width": 139
    },
    {
      "id": "exec",
      "lane": "main",
      "col": 4,
      "type": "backend",
      "label": "Registro + ejecución",
      "sublabel": "recordToolCallBeforeExecution",
      "width": 160
    },
    {
      "id": "commit",
      "lane": "main",
      "col": 5,
      "type": "database",
      "label": "Commit del paso",
      "sublabel": "recordToolResult + commitStep",
      "width": 125
    },
    {
      "id": "park",
      "lane": "wait",
      "col": 2,
      "type": "messagebus",
      "label": "parkRun",
      "sublabel": "TOOL_APPROVAL, sin commit",
      "width": 109
    },
    {
      "id": "auth",
      "lane": "wait",
      "col": 4,
      "type": "messagebus",
      "label": "Espera credencial",
      "sublabel": "parkForMissingCredential",
      "width": 139
    },
    {
      "id": "resfail",
      "lane": "close",
      "col": 1,
      "type": "security",
      "label": "Resolución fallida",
      "sublabel": "CAPABILITY_RESOLUTION_FAILED",
      "width": 146
    },
    {
      "id": "blk",
      "lane": "close",
      "col": 3,
      "type": "security",
      "label": "ToolResult fallido",
      "sublabel": "antes del commit",
      "width": 146
    }
  ],
  "edges": [
    {
      "id": "e-prop",
      "from": "prop",
      "to": "resolve"
    },
    {
      "id": "e-policy",
      "from": "resolve",
      "to": "policy",
      "variant": "emphasis"
    },
    {
      "id": "e-resfail",
      "from": "resolve",
      "to": "resfail",
      "label": "no encontrada o schema",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-allow",
      "from": "policy",
      "to": "hooks",
      "label": "ALLOW",
      "variant": "emphasis"
    },
    {
      "id": "e-req",
      "from": "policy",
      "to": "park",
      "label": "REQUIRE_APPROVAL",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "e-deny",
      "from": "policy",
      "to": "blk",
      "label": "DENY",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-block",
      "from": "hooks",
      "to": "blk",
      "label": "BLOCK",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-cred",
      "from": "hooks",
      "to": "auth",
      "label": "falta credencial",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "e-exec",
      "from": "hooks",
      "to": "exec",
      "label": "CONTINUE",
      "variant": "emphasis"
    },
    {
      "id": "e-commit",
      "from": "exec",
      "to": "commit",
      "variant": "emphasis"
    },
    {
      "id": "e-blk-commit",
      "from": "blk",
      "to": "commit",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Toda capa solo restringe",
      "items": [
        "Política por llamante solo deniega: CALLER_NOT_PERMITTED (ch38:534-574)",
        "Conexión: applyConnectionApprovalDefault solo sube ALLOW a aprobación (ch41:507-514, ch41:692-712)",
        "Hook solo bloquea: EXTENSION_BLOCKED_TOOL (ch40:608-621, ch40:719-763)"
      ]
    },
    {
      "dot": "violet",
      "title": "Ejecución por executionKind",
      "items": [
        "ISOLATED / LOCAL: executeToolCallIsolated (ch35:760-788)",
        "CONNECTION: prepareConnectionCall, MCP / OpenAPI (ch41:664-686)",
        "Agente: invokeAgentDurably (ch44:813-854)"
      ]
    },
    {
      "dot": "amber",
      "title": "Esperas y compresión",
      "items": [
        "Credencial: ch37:593-605, ch37:749-771; DENY/BLOCK: ch49:837-867",
        "parkRun reanuda con acceptDelivery y waitId (ch33:795-846)",
        "Fusionados: default de conexión en REQUIRE_APPROVAL; registro y executionKind en un nodo"
      ]
    }
  ]
}
