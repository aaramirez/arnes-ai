  "cards": [
    {
      "dot": "cyan",
      "title": "Cómo leerlo",
      "items": [
        "Ingreso → admisión → turno conectado CH-49 → núcleo (ch49:281-293).",
        "Runtime = integración, núcleo, gobierno y durabilidad: substrato compartido (P-15, constitución:147).",
        "EvaluationHarness certifica el runtime antes de producción (gate con lift)."
      ]
    },
    {
      "dot": "violet",
      "title": "21 piezas en 12 nodos",
      "items": [
        "Fuentes + Ingress Adapters; AdmissionController + ContinuationRegistry; SessionManager + AuditLedger.",
        "CredentialBroker, IdempotencyGuard, DataGovernanceEngine y RetrievalEngine juntos; ConnectionManager, AgentCommunicationGateway (ACG) y LLM juntos.",
        "El núcleo incluye también CapabilityRegistry, ExecutionController y el catálogo del ModelGateway; OperationalController → HandoffCoordinator queda dentro del nodo de control."
      ]
    },
