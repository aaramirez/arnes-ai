  "cards": [
    {
      "dot": "violet",
      "title": "Constitución, agentes y skills",
      "items": [
        "Constitución (P-01..P-30, INV) → registros components / contracts / glossary → planes/",
        "book-architect: Chapter Brief; chapter-author + skills write-technical-chapter, define-contract / component, write-pseudocode, impacto, retrieval",
        "Evidencia: ARCHITECTURE_CONSTITUTION.md:8-28, agents/book-architect.md:3-10, agents/chapter-author.md:3-8"
      ]
    },
    {
      "dot": "rose",
      "title": "Validación y build",
      "items": [
        "Validadores: contracts → components → chapter + retrieval-set; falla + publishing deny → book-state failed_validation, exit 1",
        "ok → build-book-ir (dist/book-ir.json) → build-mind-map → build-web → build-pdf (pandoc); Node sin dependencias",
        "Evidencia: policies/publishing.yaml:13-14, scripts/build-all:41-80, scripts/README.md:3-12"
      ]
    },
    {
      "dot": "slate",
      "title": "Alcance y compresión",
      "items": [
        "Archify y el PDF ejecutivo (scripts/build-flujos-doc.py) se generan fuera de build-all",
        "Compresión: skills y orden de validadores solo en tarjetas",
        "Rutas relativas a repos/aaramirez/book-harness/ (constitución en constitution/)"
      ]
    }
  ]
}
