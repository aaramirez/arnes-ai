      "width": 140
    },
    {
      "id": "registries",
      "lane": "author",
      "col": 1,
      "type": "database",
      "label": "Registros",
      "sublabel": "components / contracts",
      "tag": "+ glossary",
      "width": 140
    },
    {
      "id": "plans",
      "lane": "author",
      "col": 2,
