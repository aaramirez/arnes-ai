  "edges": [
    {
      "id": "e-k-reg",
      "from": "constitution",
      "to": "registries"
    },
    {
      "id": "e-reg-pl",
      "from": "registries",
      "to": "plans"
    },
    {
      "id": "e-pl-ba",
      "from": "plans",
      "to": "architect"
    },
    {
      "id": "e-ba-ca",
